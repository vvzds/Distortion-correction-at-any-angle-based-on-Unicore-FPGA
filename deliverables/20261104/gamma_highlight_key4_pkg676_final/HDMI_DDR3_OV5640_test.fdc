# Task1 clocks: actual PLL-derived domains and CMOS2 RAW8 byte/pixel clock.
create_clock -name {cmos2_pclk_raw} [get_ports {cmos2_pclk}] -period {11.904762}
create_generated_clock -name {pix_clk} -source [get_ports {sys_clk}] [get_pins {u_pll/u_gpll/CLKOUT0}] -multiply_by {11} -divide_by {4}
create_generated_clock -name {cfg_clk} -source [get_ports {sys_clk}] [get_pins {u_pll/u_gpll/CLKOUT1}] -multiply_by {77} -divide_by {208}
create_generated_clock -name {clk_25M} -source [get_ports {sys_clk}] [get_pins {u_pll/u_gpll/CLKOUT2}] -multiply_by {11} -divide_by {12}
# Camera connector timing budget, to be refined from oscilloscope measurements.
set_input_delay -clock {cmos2_pclk_raw} -max {3.5} [get_ports {cmos2_data[*] cmos2_href cmos2_vsync}]
set_input_delay -clock {cmos2_pclk_raw} -min {0.5} [get_ports {cmos2_data[*] cmos2_href cmos2_vsync}]

# SCCB slow clocks (24.75 MHz / 2400 = 10.3125 kHz; period below PDS 100 us limit).
create_generated_clock -name {sccb1_clk} -source [get_pins {u_pll/u_gpll/CLKOUT2}] [get_nets {coms1_reg_config.clock_20k}] -divide_by {2400}
create_generated_clock -name {sccb2_clk} -source [get_pins {u_pll/u_gpll/CLKOUT2}] [get_nets {coms2_reg_config.clock_20k}] -divide_by {2400}
# Forwarded clock and RGB/DE/sync connector budgets. Verify on the board.
create_generated_clock -name {hdmi_pclk} -source [get_pins {u_pll/u_gpll/CLKOUT0}] [get_ports {pix_clk}] -divide_by {1}
set_output_delay -clock {hdmi_pclk} -max {2.0} [get_ports {r_out[*] g_out[*] b_out[*] de_out hs_out vs_out}]
set_output_delay -clock {hdmi_pclk} -min {-0.5} [get_ports {r_out[*] g_out[*] b_out[*] de_out hs_out vs_out}]
set_clock_groups -name {video_vs_ddr} -asynchronous -group [get_clocks {sys_clk pix_clk cfg_clk clk_25M sccb1_clk sccb2_clk hdmi_pclk}] -group [get_clocks {cmos2_pclk_raw}] -group [get_clocks {ddrphy_sysclk}]


# Only reset and initial-enable cross from sys_clk into SCCB; both have two-stage synchronizers.
set_false_path -from [get_clocks {sys_clk}] -to [get_clocks {sccb1_clk sccb2_clk}]

# Unused LEDs 5/6/7 remain assigned to their board pins and are held off.
define_attribute {p:video_debug_led[0]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:video_debug_led[0]} {PAP_IO_LOC} {A18}
